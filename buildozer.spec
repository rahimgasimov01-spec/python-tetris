[app]
title = Python Tetris
package.name = pythontetris
package.domain = org.tetris
source.dir = .
source.include_exts = py
version = 0.1
requirements = python3,pygame
orientation = portrait
fullscreen = 1
android.archs = arm64-v8a, armeabi-v7a
android.allow_backup = True

[buildozer]
log_level = 2
warn_on_root = 1